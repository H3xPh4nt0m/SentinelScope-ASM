# ASM Platform configuration — copy to .env and fill in.
# Never commit a real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///asm.db

# LLM (OpenAI-compatible API)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# Optional absolute paths when scanner binaries are not on PATH
# ZAP_BINARY=/usr/share/zaproxy/zap.sh
# WEBANALYZE_BINARY=/root/go/bin/webanalyze
# WHATWEB_BINARY=/usr/bin/whatweb

APP_ENV=development
LOG_LEVEL=INFO
